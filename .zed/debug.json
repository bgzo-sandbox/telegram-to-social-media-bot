// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "SyncBot",
    "adapter": "Delve",
    "request": "launch",
    "mode": "debug",
    "program": "${ZED_WORKTREE_ROOT}/main.go",
    "cwd": "${ZED_WORKTREE_ROOT}",
    "args": ["sync", "-c", "${ZED_WORKTREE_ROOT}/config/config.yaml"],
    "envFile": "${ZED_WORKTREE_ROOT}/.env",
    "console": "integratedTerminal"
  },
  {
    "label": "Migrate:JSON to DB",
    "adapter": "Delve",
    "request": "launch",
    "mode": "debug",
    "program": "${ZED_WORKTREE_ROOT}/main.go",
    "cwd": "${ZED_WORKTREE_ROOT}",
    "args": ["migrate", "json-to-db", "-c", "${ZED_WORKTREE_ROOT}/config/config.yaml"],
    "envFile": "${ZED_WORKTREE_ROOT}/.env",
    "console": "integratedTerminal"
  },
  {
    "label": "Migrate:Db to Markdown",
    "adapter": "Delve",
    "request": "launch",
    "mode": "debug",
    "program": "${ZED_WORKTREE_ROOT}/main.go",
    "cwd": "${ZED_WORKTREE_ROOT}",
    "args": ["migrate", "backfill", "-c", "${ZED_WORKTREE_ROOT}/config/config.yaml"],
    "envFile": "${ZED_WORKTREE_ROOT}/.env",
    "console": "integratedTerminal"
  }
]
